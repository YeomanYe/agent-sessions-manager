{
  "name": "agent-sessions-manager",
  "version": "0.1.0",
  "description": "Agent session log analyzer + skill recall tuning toolkit (CLI now, webui later)",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "build": "pnpm -r build",
    "watch": "pnpm -r --parallel watch",
    "doctor": "pnpm --filter @agent-sessions-manager/cli doctor",
    "run:incr": "pnpm --filter @agent-sessions-manager/cli run --limit 100"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
